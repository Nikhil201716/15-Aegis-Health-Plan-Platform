{
  "name": "Aegis Health Plan Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": "bash .devcontainer/run-project.sh",
  "forwardPorts": [
    8000,
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit dashboard",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
